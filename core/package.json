    },
    "./ddl": {
      "types": "./src/ddl.ts",
      "default": "./src/ddl.ts"
    },
    "./plans": {
      "types": "./src/plans.ts",
      "default": "./src/plans.ts"
    },
    "./billing": {
      "types": "./src/billing.ts",
      "default": "./src/billing.ts"
    },
    "./prose": {
      "types": "./src/prose.ts",
      "default": "./src/prose.ts"
    },
    "./time": {
      "types": "./src/time.ts",
      "default": "./src/time.ts"
    },
    "./sheets": {
      "types": "./src/sheets.ts",
      "default": "./src/sheets.ts"
    },
    "./skills": {
      "types": "./src/skills.ts",
      "default": "./src/skills.ts"
    },
    "./mcp": {
      "types": "./src/mcp.ts",
