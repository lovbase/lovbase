DATABASE_URL=postgres://lovbase:lovbase@localhost:5433/lovbase
REDIS_URL=redis://localhost:6379
# Transient run recordings: TTL is renewed while running and reset on completion.
# RUN_CHUNKS_TTL_SECONDS=7200
# RUN_CHUNKS_MAX_BYTES=33554432

# Pick one of the two:
# A. Any OpenAI-compatible endpoint (OpenAI / DeepSeek / Kimi / Ollama / vLLM / a relay…)
# Note: the baseURL usually ends in /v1 (the SDK only appends /chat/completions after it)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.2

# B. Anthropic natively (LLM_MODEL is optional, defaults to claude-sonnet-5)
# ANTHROPIC_API_KEY=sk-ant-...

# Password of the low-privilege role that runs /api/data/:id/sql (the lovbase_sql role is created on first start)
SQL_ROLE_PASSWORD=change-me
# If that role should use a separate connection string (by default DATABASE_URL is reused with the user name swapped):
# DATABASE_SQL_URL=postgres://lovbase_sql:...@.../lovbase
# Pool sizes, 10 each by default
# PG_POOL_MAX=10
# PG_SQL_POOL_MAX=10

BETTER_AUTH_SECRET=change-me-to-something-long
BETTER_AUTH_URL=http://localhost:3008

# The sandbox service. Locally the Docker runner is recommended (bun run runner, 8788); for the Cloudflare version, cd sandbox && bun run dev (8787)
SANDBOX_URL=http://localhost:8788
SANDBOX_INTERNAL_TOKEN=dev-internal-token

# Social login. A provider's button only appears when both of its values are set; the callback URL is <BETTER_AUTH_URL>/api/auth/callback/<provider>
# GitHub: Settings → Developer settings → OAuth Apps, callback = https://lovbase.dev/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google: Cloud Console → APIs & Services → Credentials → OAuth client (Web),
#   authorized redirect URI = https://lovbase.dev/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile, in front of email sign-up / sign-in. Enabled only when both are set; unset means no bot check (fine for a private deployment).
# Cloudflare dashboard → Turnstile → Add widget, with the site's domain (for local development use the 1x00000000000000000000AA / 1x0000000000000000000000000000000AA test pair)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Comma-separated; these emails become admins automatically after signing in (/admin)
ADMIN_EMAILS=you@example.com

# Guardrails for the shared cluster
WS_RATE_PER_MIN=300
FREE_QUOTA_MB=200
PRO_QUOTA_MB=5000

# The domain published apps are served under (https://<slug>.<APPS_DOMAIN>)
# APPS_DOMAIN=lovbase.app

# Stripe. Without it the upgrade button only records the intent and takes no payment
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...      STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_... STRIPE_PRICE_BUSINESS_YEARLY=price_...
# Credit packs (one-time payments; bought credits go into the wallet and do not reset with the period). The ids are CREDIT_PACKS in core/src/plans.ts
# STRIPE_PRICE_CREDITS_SMALL=price_...  STRIPE_PRICE_CREDITS_MEDIUM=price_...  STRIPE_PRICE_CREDITS_LARGE=price_...

# Product analytics. Unset means it is fully disabled (keep it unset for a private deployment).
# Note that VITE_* values are injected at build time, so a change needs a new build.
# VITE_POSTHOG_KEY=phc_...

# Where /ingest/* is proxied to (defaults to PostHog US)
# POSTHOG_API_HOST=us.i.posthog.com
# POSTHOG_ASSET_HOST=us-assets.i.posthog.com

# Extra origins auth accepts (comma-separated). The origin of BETTER_AUTH_URL is always accepted; once a deployment has a second domain
# (the platform's own domain plus a custom one), signing in on the other fails with Invalid origin, so list it here.
# BETTER_AUTH_TRUSTED_ORIGINS=https://xxx.up.railway.app

# Attachment storage (S3 API). Unset falls back to storing images as base64 in lb_chat — it works, but every screenshot lands in Postgres
# and is sent to the model again on every later turn, so set it in production.
# Local: docker compose up -d  brings up MinIO with the bucket, then use this set
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=lovbase-uploads
# S3_ACCESS_KEY_ID=lovbase
# S3_SECRET_ACCESS_KEY=lovbase123
# Cloudflare R2 in production: endpoint is https://<account_id>.r2.cloudflarestorage.com, keep REGION at auto
# S3_REGION=auto

# The bucket the sandbox Worker writes published apps and build snapshots into (its R2 binding,
# `r2_buckets` in sandbox/wrangler.jsonc). Read-only from here, and only for snapshots: a published
# app is served by the Worker itself. Same account as the S3_* credentials above, so it needs no
# others. Empty turns build snapshots off, and reopening an app wakes a container as it used to.
# SANDBOX_BUCKET=lovbase-apps
# ...and the endpoint that bucket answers on, if it differs. R2 addresses a bucket through its
# jurisdiction — `<account>.r2.…` for the default one, `<account>.us.r2.…` and `.eu.r2.…` for the
# others — and a bucket is invisible on any endpoint but its own, answering `NoSuchBucket` rather
# than a permission error. Two buckets in one account need not share one. Empty means "same as
# S3_ENDPOINT".
# SANDBOX_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# The full list is in api/src/config/config.service.ts — every environment variable is declared there and validated once at startup

# ── Traffic figures for published apps ────────────────────────────────────────
# Counted by Cloudflare at the edge, per app subdomain, so nothing of ours runs inside a generated
# application. Unset means the analytics pane shows engagement only and says the rest is not
# configured. The token needs Analytics · Read — the one that deploys the Worker does not have it,
# and a token that only deploys will fail here with a permission error naming zone.analytics.read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# How many turns may build at once. The hard ceiling is max_instances in sandbox/wrangler.jsonc;
# this is the one the app enforces, so it can be changed without deploying the Worker.
# Concurrent builds the app will allow. Must not exceed `max_instances` in sandbox/wrangler.jsonc
# — the app refusing is a sentence, Cloudflare refusing is a stall.
MAX_ACTIVE_BUILDS=5
