{
  "name": "@lovbase/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rspack build && tsc -p tsconfig.json",
    "dev": "concurrently -n bundle,types -c blue,gray \"rspack build --watch\" \"tsc -p tsconfig.json --watch --preserveWatchOutput\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.evals.json",
    "eval": "bun run evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3",
    "@lovbase/core": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "ai": "^7",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.2",
    "express": "^5.2.1",
    "hono": "^4.13.5",
    "ioredis": "^6.0.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@lovbase/sandbox": "workspace:*",
    "@rspack/cli": "^2.2.6",
    "@rspack/core": "^2.2.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.2"
  }
}
