{
  "name": "lovbase",
  "private": true,
  "workspaces": [
    "api",
    "app",
    "core",
    "sandbox",
    "sandbox/runner",
    "templates"
  ],
  "scripts": {
    "dev": "bun run --cwd api build && concurrently -n api,web,worker -c cyan,magenta,yellow \"bun run --cwd api dev\" \"bun run --cwd app dev\" \"node --watch api/dist/worker.js\"",
    "start:web": "bun run --cwd app start",
    "start:worker": "bun run --cwd api start:worker",
    "runner": "bun run --cwd sandbox/runner dev",
    "test": "node api/scripts/package-templates.mjs && bun test core/tests api/tests app/tests sandbox/tests",
    "lint": "oxlint",
    "typecheck": "bun run --cwd api typecheck && bun run --cwd app typecheck",
    "build": "bun run --cwd api build && bun run --cwd app build",
    "start": "bun run --cwd app start",
    "deploy:sandbox": "bun run --cwd sandbox deploy",
    "eval": "bun run --cwd api eval",
    "stripe:setup": "bun api/scripts/setup-stripe-test.ts",
    "stripe:listen": "bun api/scripts/stripe-listen.ts",
    "stripe:preflight": "bun api/scripts/stripe-preflight.ts",
    "stripe:setup:live": "bun api/scripts/setup-stripe-live.ts",
    "stripe:migrate": "bun api/scripts/migrate-stripe-test.ts",
    "stripe:sync-webhook": "bun api/scripts/stripe-sync-webhook.ts",
    "stripe:test-refunds": "bun api/scripts/test-stripe-refunds.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "concurrently": "^9.2.1",
    "oxlint": "^1.83.0"
  }
}
